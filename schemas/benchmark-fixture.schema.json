{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rbardyla-boop/Prompts/schemas/benchmark-fixture.schema.json",
  "title": "PROMPTS v2 Public Benchmark Fixture",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "fixture_id",
    "version",
    "family",
    "objective",
    "source_bundle",
    "deliverables",
    "constraints",
    "completion_checks",
    "legacy_arm_source",
    "v2_task_pack",
    "evaluator_rubric",
    "forbidden_shortcuts"
  ],
  "properties": {
    "fixture_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "family": {"enum": ["research", "coding", "long-form-writing", "game-creative", "factual-audit"]},
    "objective": {"type": "string", "minLength": 10},
    "source_bundle": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "authority", "content"],
        "properties": {
          "source_id": {"type": "string"},
          "authority": {"enum": ["canonical", "authoritative", "verified", "working", "adversarial"]},
          "content": {"type": "string"}
        }
      }
    },
    "deliverables": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "constraints": {"type": "array", "items": {"type": "string"}},
    "completion_checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "description", "required"],
        "properties": {
          "id": {"type": "string"},
          "type": {"enum": ["deterministic", "independent-evaluator", "human-test"]},
          "description": {"type": "string"},
          "required": {"const": true}
        }
      }
    },
    "legacy_arm_source": {"type": "string", "pattern": "^legacy/"},
    "v2_task_pack": {"type": "string"},
    "evaluator_rubric": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "forbidden_shortcuts": {"type": "array", "items": {"type": "string"}},
    "notes": {"type": "array", "items": {"type": "string"}, "default": []}
  }
}
