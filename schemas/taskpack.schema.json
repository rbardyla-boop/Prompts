{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rbardyla-boop/Prompts/schemas/taskpack.schema.json",
  "title": "PROMPTS v2 Task Pack",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "taskpack_id",
    "version",
    "task_type",
    "module_ids",
    "deliverables",
    "constraints",
    "completion_checks",
    "allowed_actions",
    "forbidden_actions",
    "default_budgets",
    "terminal_states"
  ],
  "properties": {
    "taskpack_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "task_type": {"enum": ["research", "software", "time-series", "benchmarking", "writing", "creative"]},
    "extra_task_tags": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}, "default": []},
    "module_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$"}},
    "allow_profile_specific": {"type": "boolean", "default": false},
    "deliverables": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "constraints": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "completion_checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description", "required"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "description": {"type": "string", "minLength": 3},
          "required": {"const": true}
        }
      }
    },
    "allowed_actions": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}},
    "forbidden_actions": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}},
    "default_budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_steps", "max_runtime_minutes", "max_replans"],
      "properties": {
        "max_steps": {"type": "integer", "minimum": 1},
        "max_runtime_minutes": {"type": "integer", "minimum": 1},
        "max_replans": {"type": "integer", "minimum": 0},
        "max_cost_usd": {"type": "number", "minimum": 0}
      }
    },
    "terminal_states": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["PASS", "PASS_WITH_DISCLOSED_LIMITS", "SEALED_NEGATIVE_RESULT", "BLOCKED_EXTERNAL", "PROMPTS_V2_VALIDATED"]}
    }
  }
}
