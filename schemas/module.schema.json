{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rbardyla-boop/Prompts/schemas/module.schema.json",
  "title": "PROMPTS v2 Module Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "module_id",
    "version",
    "title",
    "classification",
    "status",
    "source_refs",
    "purpose",
    "applies_to",
    "does_not_apply_to",
    "inputs",
    "outputs",
    "context_cost",
    "default_include",
    "hard_rules",
    "checks",
    "failure_conditions"
  ],
  "properties": {
    "module_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "title": {"type": "string", "minLength": 3},
    "classification": {
      "enum": [
        "INVARIANT",
        "CONFIGURABLE_POLICY",
        "HEURISTIC",
        "DOMAIN_METHOD",
        "TOOL_ADAPTER"
      ]
    },
    "status": {
      "enum": ["ACTIVE", "PROFILE_SPECIFIC", "DEPRECATED", "ARCHIVE_ONLY", "QUARANTINED"]
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "sections"],
        "properties": {
          "path": {"type": "string", "pattern": "^legacy/"},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "sections": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        }
      }
    },
    "purpose": {"type": "string", "minLength": 10},
    "applies_to": {"type": "array", "items": {"type": "string"}},
    "does_not_apply_to": {"type": "array", "items": {"type": "string"}},
    "inputs": {"type": "array", "items": {"type": "string"}},
    "outputs": {"type": "array", "items": {"type": "string"}},
    "context_cost": {"enum": ["LOW", "MEDIUM", "HIGH"]},
    "default_include": {"type": "boolean"},
    "required_tools": {"type": "array", "items": {"type": "string"}, "default": []},
    "required_evidence": {"type": "array", "items": {"type": "string"}, "default": []},
    "dependencies": {"type": "array", "items": {"type": "string"}, "default": []},
    "conflicts": {"type": "array", "items": {"type": "string"}, "default": []},
    "hard_rules": {"type": "array", "items": {"type": "string"}},
    "configurable_parameters": {
      "type": "object",
      "additionalProperties": {
        "type": ["string", "number", "integer", "boolean", "null", "array", "object"]
      },
      "default": {}
    },
    "checks": {"type": "array", "items": {"type": "string"}},
    "failure_conditions": {"type": "array", "items": {"type": "string"}},
    "legacy_claims_not_imported": {"type": "array", "items": {"type": "string"}, "default": []},
    "notes": {"type": "array", "items": {"type": "string"}, "default": []}
  }
}
